# ===== IMAGEN NGINX =====
# Usa imagen oficial de Nginx con Alpine Linux (muy ligera)
FROM nginx:alpine

# Crea directorios para archivos estáticos
# (preparados para futuras páginas de error personalizadas e imágenes)
RUN mkdir -p /usr/share/nginx/error_pages
RUN mkdir -p /usr/share/nginx/html/assets/images

# Copia tu configuración personalizada de Nginx
# Reemplaza la configuración por defecto
COPY nginx.conf /etc/nginx/conf.d/default.conf
